# Copy to .env.local and fill in. Never commit .env.local.
#
# Hosted project: Supabase Dashboard → Project Settings → API (Data API / API Keys).
# Local project:  run `npx supabase status` after `npx supabase start`.

# Project URL — public, used by browser and server.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...) or legacy "anon" key — public by design;
# Row Level Security decides what it can access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...) or legacy "service_role" key — SERVER ONLY.
# Bypasses Row Level Security. Used only by admin/demo scripts, never by the
# app's pages, and never prefixed with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
